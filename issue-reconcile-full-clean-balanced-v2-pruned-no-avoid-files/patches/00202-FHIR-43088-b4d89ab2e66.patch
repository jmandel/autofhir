diff --git a/source/measurereport/measurereport-countquantity-example.xml b/source/measurereport/measurereport-countquantity-example.xml
new file mode 100644
index 00000000000..8f65a414ddf
--- /dev/null
+++ b/source/measurereport/measurereport-countquantity-example.xml
@@ -0,0 +1,60 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<MeasureReport xmlns="http://hl7.org/fhir" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://hl7.org/fhir ../../schema/measurereport.xsd">
+  <id value="measurereport-countquantity-example"/>
+  <text>
+    <status value="generated"/>
+    <div xmlns="http://www.w3.org/1999/xhtml">
+      <p>Example patient-level linear combination composite MeasureReport using countQuantity for decimal-valued population counts.</p>
+    </div>
+  </text>
+  <status value="complete"/>
+  <type value="summary"/>
+  <measure value="http://example.com/Measure/measure-composite-measure-linearComponentOnemeasure-linearComponentTwo"/>
+  <period>
+    <start value="2023-01-01"/>
+    <end value="2023-12-31"/>
+  </period>
+  <group>
+    <scoring>
+      <coding>
+        <system value="http://terminology.hl7.org/CodeSystem/measure-scoring"/>
+        <code value="composite"/>
+        <display value="Composite"/>
+      </coding>
+    </scoring>
+    <compositeScoring>
+      <coding>
+        <system value="http://terminology.hl7.org/CodeSystem/composite-measure-scoring"/>
+        <code value="linear"/>
+        <display value="Linear"/>
+      </coding>
+    </compositeScoring>
+    <population>
+      <code>
+        <coding>
+          <system value="http://terminology.hl7.org/CodeSystem/measure-population"/>
+          <code value="denominator"/>
+          <display value="Denominator"/>
+        </coding>
+      </code>
+      <countQuantity>
+        <value value="3"/>
+      </countQuantity>
+    </population>
+    <population>
+      <code>
+        <coding>
+          <system value="http://terminology.hl7.org/CodeSystem/measure-population"/>
+          <code value="numerator"/>
+          <display value="Numerator"/>
+        </coding>
+      </code>
+      <countQuantity>
+        <value value="1.5"/>
+      </countQuantity>
+    </population>
+    <measureScoreQuantity>
+      <value value="0.5"/>
+    </measureScoreQuantity>
+  </group>
+</MeasureReport>
