diff --git a/source/provenance/provenance-example7.xml b/source/provenance/provenance-example7.xml
new file mode 100644
index 00000000000..716958d9db1
--- /dev/null
+++ b/source/provenance/provenance-example7.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<Provenance xmlns="http://hl7.org/fhir" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://hl7.org/fhir ../../schema/provenance.xsd">
+  <id value="example7"/>
+  <!--
+    The Procedure was extracted from the first line item of the source Claim.
+  -->
+  <target>
+    <reference value="Procedure/example/_history/1"/>
+  </target>
+  <recorded value="2021-12-09T10:23:45+11:00"/>
+  <agent>
+    <type>
+      <coding>
+        <system value="http://terminology.hl7.org/CodeSystem/v3-ParticipationType"/>
+        <code value="AUT"/>
+      </coding>
+    </type>
+    <who>
+      <reference value="Practitioner/example"/>
+    </who>
+  </agent>
+  <entity>
+    <role value="source"/>
+    <what>
+      <extension url="http://hl7.org/fhir/StructureDefinition/targetPath">
+        <valueString value="Claim.item[0]"/>
+      </extension>
+      <reference value="Claim/100150"/>
+      <display value="Claim line item"/>
+    </what>
+  </entity>
+</Provenance>
