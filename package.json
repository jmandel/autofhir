{
  "name": "autofhir",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Local orchestration tools for running AutoFHIR agent pipelines over HL7 FHIR source work.",
  "scripts": {
    "build:review-app": "bun build web/review-app/src/main.tsx --outfile=/tmp/autofhir-review-app.js --format=esm --target=browser --production",
    "cleanup:run-space": "bun scripts/cleanup-run-space.ts",
    "status": "bun scripts/status.ts",
    "start": "bun scripts/start.ts",
    "export:issue-fixup-review": "bun scripts/export-issue-fixup-diff-viewer.ts",
    "export:issue-mapping-review": "bun scripts/export-issue-mapping-viewer.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
}
