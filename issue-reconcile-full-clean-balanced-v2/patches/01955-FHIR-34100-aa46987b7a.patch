+			<system value="http://terminology.hl7.org/CodeSystem/encounter-subject-status"/>
+			<code value="receiving-care"/>
+		</coding>
+	</subjectStatus>
+    <participant>
+        <actor>
+            <reference value="#other"/>
+        </actor>
+    </participant>
+</Encounter>
