+  <extension url="http://hl7.org/fhir/build/StructureDefinition/footer">
+    <valueMarkdown value="The result of this operation is a Bundle for each subject, where the Bundle contains Request resources that are the direct result of applying the RequestOrchestration to that subject. The Bundle will have entries for each of the applicable actions in the RequestOrchestration based on evaluating the applicability condition in context, and producing Request resources based on the definition, resource, transform, and dynamicValue elements for each applicable action.&#xA;&#xA;For each applicable action, the definition is applied as described in the $apply operation of the ActivityDefinition and PlanDefinition resources, and the resulting resource is added as an entry to the Bundle. The resulting Bundle may be any combination of Request resources, including CarePlan, RequestOrchestration, and individual Request resources such as ServiceRequest and MedicationRequest.&#xA;&#xA;Parameters to the $apply operation are available within dynamicValue expressions as context variables, accessible by the name of the parameter, prefixed with a percent (%) symbol.&#xA;&#xA;For a more detailed description, refer to the RequestOrchestration, PlanDefinition, and ActivityDefinition resource documentation. Note that result of this operation is transient (i.e. none of the resources created by the operation are persisted in the server, they are all returned as entries in the result Bundle(s)). The result effectively represents a proposed set of activities, and it is up to the caller to determine whether and how those activities are actually carried out and/or persisted."/>
+  </extension>
+  <url value="http://hl7.org/fhir/build/OperationDefinition/RequestOrchestration-apply"/>
+  <version value="6.0.0"/>
+  <name value="Apply"/>
+  <title value="Apply"/>
+  <status value="draft"/>
+  <kind value="operation"/>
+  <date value="2022-08-30T21:00:06-06:00"/>
+  <publisher value="HL7 (FHIR Project)"/>
+  <contact>
+    <telecom>
+      <system value="url"/>
+      <value value="http://hl7.org/fhir"/>
+    </telecom>
+    <telecom>
+      <system value="email"/>
+      <value value="fhir@lists.hl7.org"/>
+    </telecom>
+  </contact>
+  <description value="The apply operation applies a RequestOrchestration to a given subject or group of subjects, instantiating applicable actions and returning the results as bundles of request resources."/>
+  <affectsState value="false"/>
+  <code value="apply"/>
+  <comment value="The result of this operation is a Bundle for each subject, where the Bundle contains Request resources that are the direct result of applying the RequestOrchestration to that subject. The Bundle will have entries for each of the applicable actions in the RequestOrchestration based on evaluating the applicability condition in context, and producing Request resources based on the definition, resource, transform, and dynamicValue elements for each applicable action.&#xA;&#xA;For each applicable action, the definition is applied as described in the $apply operation of the ActivityDefinition and PlanDefinition resources, and the resulting resource is added as an entry to the Bundle. The resulting Bundle may be any combination of Request resources, including CarePlan, RequestOrchestration, and individual Request resources such as ServiceRequest and MedicationRequest.&#xA;&#xA;Parameters to the $apply operation are available within dynamicValue expressions as context variables, accessible by the name of the parameter, prefixed with a percent (%) symbol.&#xA;&#xA;For a more detailed description, refer to the RequestOrchestration, PlanDefinition, and ActivityDefinition resource documentation. Note that result of this operation is transient (i.e. none of the resources created by the operation are persisted in the server, they are all returned as entries in the result Bundle(s)). The result effectively represents a proposed set of activities, and it is up to the caller to determine whether and how those activities are actually carried out and/or persisted."/>
+  <resource value="RequestOrchestration"/>
+  <system value="false"/>
+  <type value="true"/>
+  <instance value="true"/>
+  <parameter>
+    <name value="requestOrchestration"/>
+    <use value="in"/>
+    <scope value="type"/>
+    <min value="0"/>
+    <max value="1"/>
+    <documentation value="The request orchestration to be applied. If the operation is invoked at the instance level, this parameter is not allowed; if the operation is invoked at the type level, this parameter is required."/>
+    <type value="RequestOrchestration"/>
+  </parameter>
+  <parameter>
+    <name value="subject"/>
+    <use value="in"/>
+    <min value="1"/>
+    <max value="*"/>
+    <documentation value="The subject(s) that is/are the target of the request orchestration to be applied. The subject may be a Patient, Practitioner, PractitionerRole, RelatedPerson, Organization, Location, Device, HealthcareService, CareTeam, or Group. Subjects provided in this parameter will be resolved as the subject of the RequestOrchestration based on the type of the subject. If multiple subjects of the same type are provided, the behavior is implementation-defined."/>
+    <type value="string"/>
+    <searchType value="reference"/>
+  </parameter>
+  <parameter>
+    <name value="encounter"/>
+    <use value="in"/>
+    <min value="0"/>
+    <max value="1"/>
+    <documentation value="The encounter in context, if any"/>
+    <type value="string"/>
+    <searchType value="reference"/>
+  </parameter>
+  <parameter>
+    <name value="practitioner"/>
+    <use value="in"/>
+    <min value="0"/>
+    <max value="1"/>
+    <documentation value="The practitioner applying the request orchestration"/>
+    <type value="string"/>
+    <searchType value="reference"/>
+  </parameter>
+  <parameter>
+    <name value="organization"/>
+    <use value="in"/>
+    <min value="0"/>
+    <max value="1"/>
+    <documentation value="The organization applying the request orchestration"/>
+    <type value="string"/>
+    <searchType value="reference"/>
+  </parameter>
+  <parameter>
