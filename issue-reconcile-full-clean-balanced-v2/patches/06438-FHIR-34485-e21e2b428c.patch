+function getTabIndexFromHash(hash) {
+  if (!hash)
+    return null;
+
+  var tabHash = hash;
+  if (tabHash.indexOf('#tab-') == 0)
+    tabHash = '#tabs-' + tabHash.substring(5);
+
+  var tabIndex = null;
+  $('#tabs > ul > li > a').each(function(index, anchor) {
+    if ($(anchor).attr('href') == tabHash) {
+      tabIndex = index;
+      return false;
+    }
+  });
+
+  return tabIndex;
+}
