<?xml version="1.0" encoding="UTF-8"?>

<CapabilityStatement xmlns="http://hl7.org/fhir">
  <id value="requirements-example"/>
  <url value="http://hl7.org/fhir/CapabilityStatement/requirements-example"/>
  <identifier>
    <system value="urn:ietf:rfc:3986"/>
    <value value="urn:oid:2.16.840.1.113883.4.642.34.9"/>
  </identifier>
  <version value="6.0.0"/>
  <name value="ExampleRequirementsCapabilityStatement"/>
  <title value="Example Requirements Capability Statement"/>
  <status value="draft"/>
  <experimental value="true"/>
  <date value="2026-05-25"/>
  <publisher value="FHIR Project"/>
  <contact>
    <telecom>
      <system value="url"/>
      <value value="http://hl7.org/fhir"/>
    </telecom>
  </contact>
  <description value="Example requirements CapabilityStatement showing how the capabilitystatement-expectation extension declares the degree of expectation associated with capabilities in a desired solution."/>
  <kind value="requirements"/>
  <fhirVersion value="6.0.0"/>
  <format value="json"/>
  <format value="xml"/>
  <rest>
    <mode value="server"/>
    <documentation value="Example requirements for a desired patient-facing FHIR server."/>
    <resource>
      <type value="Patient"/>
      <profile value="http://hl7.org/fhir/StructureDefinition/Patient"/>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <code value="read"/>
        <documentation value="The desired system is expected to support reading Patient resources."/>
      </interaction>
      <interaction>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHOULD"/>
        </extension>
        <code value="search-type"/>
        <documentation value="The desired system is expected to support searching Patient resources where practical."/>
      </interaction>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="SHALL"/>
        </extension>
        <name value="identifier"/>
        <definition value="http://hl7.org/fhir/SearchParameter/Patient-identifier"/>
        <type value="token"/>
        <documentation value="Search by patient identifier is required for conformance to these requirements."/>
      </searchParam>
      <searchParam>
        <extension url="http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation">
          <valueCode value="MAY"/>
        </extension>
        <name value="name"/>
        <definition value="http://hl7.org/fhir/SearchParameter/Patient-name"/>
        <type value="string"/>
        <documentation value="Search by patient name is optional for conformance to these requirements."/>
      </searchParam>
    </resource>
  </rest>
</CapabilityStatement>
