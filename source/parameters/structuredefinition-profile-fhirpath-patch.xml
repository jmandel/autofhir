<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="fhirpath-patch"/>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm">
    <valueInteger value="3"/>
  </extension>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-wg">
    <valueCode value="fhir"/>
  </extension>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
    <valueCode value="normative"/>
  </extension>
  <url value="http://hl7.org/fhir/StructureDefinition/fhirpath-patch"/>
  <version value="6.0.0"/>
  <name value="FHIRPathPatchProfile"/>
  <title value="FHIRPath Patch Profile"/>
  <status value="draft"/>
  <experimental value="false"/>
  <date value="2019-06-06"/>
  <publisher value="HL7 International / FHIR Infrastructure"/>
  <contact>
    <telecom>
      <system value="url"/>
      <value value="http://hl7.org/special/committees/fiwg"/>
    </telecom>
  </contact>
  <description value="Describes the valid use of a Parameters resource for a FHIRPath"/>
  <jurisdiction>
    <coding>
      <system value="http://unstats.un.org/unsd/methods/m49/m49.htm"/>
      <code value="001"/>
      <display value="World"/>
    </coding>
  </jurisdiction>
  <fhirVersion value="6.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="Parameters"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Parameters"/>
  <derivation value="constraint"/>
  <differential>
    <element id="Parameters.parameter">
      <path value="Parameters.parameter"/>
      <short value="One root level parameter for each patch operation"/>
      <min value="0"/>
      <max value="*"/>
      <constraint>
        <key value="fpp-1"/>
        <severity value="error"/>
        <human value="A FHIRPath Patch add operation SHALL have name and value parts and SHALL NOT have index, source, or destination parts"/>
        <expression value="part.where(name = 'type').value = 'add' implies (part.where(name = 'name').exists() and part.where(name = 'value').exists() and part.where(name = 'index' or name = 'source' or name = 'destination').empty())"/>
        <source value="http://hl7.org/fhir/StructureDefinition/fhirpath-patch"/>
      </constraint>
      <constraint>
        <key value="fpp-2"/>
        <severity value="error"/>
        <human value="A FHIRPath Patch insert operation SHALL have value and index parts and SHALL NOT have name, source, or destination parts"/>
        <expression value="part.where(name = 'type').value = 'insert' implies (part.where(name = 'value').exists() and part.where(name = 'index').exists() and part.where(name = 'name' or name = 'source' or name = 'destination').empty())"/>
        <source value="http://hl7.org/fhir/StructureDefinition/fhirpath-patch"/>
      </constraint>
      <constraint>
        <key value="fpp-3"/>
        <severity value="error"/>
        <human value="A FHIRPath Patch delete operation SHALL NOT have name, value, index, source, or destination parts"/>
        <expression value="part.where(name = 'type').value = 'delete' implies part.where(name = 'name' or name = 'value' or name = 'index' or name = 'source' or name = 'destination').empty()"/>
        <source value="http://hl7.org/fhir/StructureDefinition/fhirpath-patch"/>
      </constraint>
      <constraint>
        <key value="fpp-4"/>
        <severity value="error"/>
        <human value="A FHIRPath Patch replace operation SHALL have a value part and SHALL NOT have name, index, source, or destination parts"/>
        <expression value="part.where(name = 'type').value = 'replace' implies (part.where(name = 'value').exists() and part.where(name = 'name' or name = 'index' or name = 'source' or name = 'destination').empty())"/>
        <source value="http://hl7.org/fhir/StructureDefinition/fhirpath-patch"/>
      </constraint>
      <constraint>
        <key value="fpp-5"/>
        <severity value="error"/>
        <human value="A FHIRPath Patch move operation SHALL have source and destination parts and SHALL NOT have name, value, or index parts"/>
        <expression value="part.where(name = 'type').value = 'move' implies (part.where(name = 'source').exists() and part.where(name = 'destination').exists() and part.where(name = 'name' or name = 'value' or name = 'index').empty())"/>
        <source value="http://hl7.org/fhir/StructureDefinition/fhirpath-patch"/>
      </constraint>
    </element>
    <element id="Parameters.parameter.name">
      <path value="Parameters.parameter.name"/>
      <fixedString value="operation"/>
    </element>
    <element id="Parameters.parameter.part">
      <path value="Parameters.parameter.part"/>
      <slicing>
        <discriminator>
          <type value="value"/>
          <path value="name"/>
        </discriminator>
        <description value="one slice for each parameter, discriminated by name. Parameter order is not important. Extension parameters are not allowed"/>
        <ordered value="false"/>
        <rules value="closed"/>
      </slicing>
      <short value="Each parameter to the operation is a part. See documentation for rules about which parts are required"/>
      <min value="1"/>
      <max value="7"/>
    </element>

    <element id="Parameters.parameter.part:type">
      <path value="Parameters.parameter.part"/>
      <sliceName value="type"/>
      <short value="Operation to perform: add | insert | delete | replace | move"/>
      <min value="1"/>
      <max value="1"/>
    </element>
    <element id="Parameters.parameter.part:type.name">
      <path value="Parameters.parameter.part.name"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <fixedString value="type"/>
    </element>
    <element id="Parameters.parameter.part:type.value[x]">
      <path value="Parameters.parameter.part.value[x]"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="code"/>
      </type>
      <binding>
        <strength value="required"/>
        <valueSet value="http://hl7.org/fhir/ValueSet/patch-operation"/>
      </binding>
    </element>

    <element id="Parameters.parameter.part:path">
      <path value="Parameters.parameter.part"/>
      <sliceName value="path"/>
      <short value="Path - where to perform the operation"/>
      <min value="1"/>
      <max value="1"/>
    </element>
    <element id="Parameters.parameter.part:path.name">
      <path value="Parameters.parameter.part.name"/>
      <min value="1"/>
      <max value="1"/>
      <fixedString value="path"/>
    </element>
    <element id="Parameters.parameter.part:path.value[x]">
      <path value="Parameters.parameter.part.value[x]"/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="string"/>
      </type>
    </element>

    <element id="Parameters.parameter.part:name">
      <path value="Parameters.parameter.part"/>
      <sliceName value="name"/>
      <short value="name of the property to add (add operation only)"/>
      <min value="0"/>
      <max value="1"/>
    </element>
    <element id="Parameters.parameter.part:name.name">
      <path value="Parameters.parameter.part.name"/>
      <min value="1"/>
      <max value="1"/>
      <fixedString value="name"/>
    </element>
    <element id="Parameters.parameter.part:name.value[x]">
      <path value="Parameters.parameter.part.value[x]"/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="string"/>
      </type>
    </element>

    <element id="Parameters.parameter.part:value">
      <path value="Parameters.parameter.part"/>
      <sliceName value="value"/>
      <short value="Value to add, insert, or replace - any valid datatype or nested parts"/>
      <min value="0"/>
      <max value="1"/>
      <constraint>
        <key value="fpp-6"/>
        <severity value="error"/>
        <human value="The value part SHALL contain a value or nested parts"/>
        <expression value="value.exists() or part.exists()"/>
        <source value="http://hl7.org/fhir/StructureDefinition/fhirpath-patch"/>
      </constraint>
    </element>
    <element id="Parameters.parameter.part:value.name">
      <path value="Parameters.parameter.part.name"/>
      <min value="1"/>
      <max value="1"/>
      <fixedString value="value"/>
    </element>
    <element id="Parameters.parameter.part:value.value[x]">
      <path value="Parameters.parameter.part.value[x]"/>
      <min value="0"/>
      <max value="1"/>
    </element>
    <element id="Parameters.parameter.part:value.resource">
      <path value="Parameters.parameter.part.resource"/>
      <max value="0"/>
    </element>

    <element id="Parameters.parameter.part:index">
      <path value="Parameters.parameter.part"/>
      <sliceName value="index"/>
      <short value="Index at which insert (insert operation only)"/>
      <min value="0"/>
      <max value="1"/>
    </element>
    <element id="Parameters.parameter.part:index.name">
      <path value="Parameters.parameter.part.name"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <fixedString value="index"/>
    </element>
    <element id="Parameters.parameter.part:index.value[x]">
      <path value="Parameters.parameter.part.value[x]"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="integer"/>
      </type>
    </element>

    <element id="Parameters.parameter.part:source">
      <path value="Parameters.parameter.part"/>
      <sliceName value="source"/>
      <short value="0-based list index to move from (move operation only)"/>
      <definition value="The 0-based index of the element to remove from the nominated list before inserting it at the destination index."/>
      <min value="0"/>
      <max value="1"/>
    </element>
    <element id="Parameters.parameter.part:source.name">
      <path value="Parameters.parameter.part.name"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <fixedString value="source"/>
    </element>
    <element id="Parameters.parameter.part:source.value[x]">
      <path value="Parameters.parameter.part.value[x]"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="integer"/>
      </type>
    </element>

    <element id="Parameters.parameter.part:destination">
      <path value="Parameters.parameter.part"/>
      <sliceName value="destination"/>
      <short value="0-based list index to move to after removal (move operation only)"/>
      <definition value="The 0-based index at which to insert the moved element after removing it from the source index."/>
      <min value="0"/>
      <max value="1"/>
    </element>
    <element id="Parameters.parameter.part:destination.name">
      <path value="Parameters.parameter.part.name"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <fixedString value="destination"/>
    </element>
    <element id="Parameters.parameter.part:destination.value[x]">
      <path value="Parameters.parameter.part.value[x]"/>
      <short value=""/>
      <min value="1"/>
      <max value="1"/>
      <type>
        <code value="integer"/>
      </type>
    </element>


  </differential>
</StructureDefinition>
