  </identifier>
  <version value="6.0.0"/>
  <name value="SearchModifierCode"/>
  <title value="Search Modifier Code"/>
  <status value="active"/>
  <experimental value="false"/>
  <date value="2021-01-05T10:01:24+11:00"/>
  <publisher value="HL7 (FHIR Project)"/>
  <contact>
    <telecom>
      <system value="url"/>
      <value value="http://hl7.org/fhir"/>
    </telecom>
    <telecom>
      <system value="email"/>
      <value value="fhir@lists.hl7.org"/>
    </telecom>
  </contact>
  <description value="A supported modifier for a search parameter."/>
  <caseSensitive value="true"/>
  <valueSet value="http://hl7.org/fhir/ValueSet/search-modifier-code"/>
  <content value="complete"/>
  <property>
    <extension url="http://hl7.org/fhir/StructureDefinition/codesystem-property-valueset">
      <valueCanonical value="http://hl7.org/fhir/ValueSet/search-param-type"/>
    </extension>
    <code value="search-param-type"/>
    <uri value="http://hl7.org/fhir/search-modifier-code#search-param-type"/>
    <description value="Search parameter type for which this modifier is generally defined."/>
    <type value="code"/>
  </property>
  <concept>
    <code value="missing"/>
    <display value="Missing"/>
    <definition value="The search parameter returns resources that have a value or not."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="date"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="number"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="quantity"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="string"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="uri"/>
    </property>
  </concept>
  <concept>
    <code value="exact"/>
    <display value="Exact"/>
    <definition value="The search parameter returns resources that have a value that exactly matches the supplied parameter (the whole string, including casing and accents)."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="string"/>
    </property>
  </concept>
  <concept>
    <code value="contains"/>
    <display value="Contains"/>
    <definition value="The search parameter returns resources that match the supplied parameter value as a containment test: anywhere within the field being searched, or within the tree covered by a supported hierarchical relationship."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="string"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="uri"/>
    </property>
  </concept>
  <concept>
    <code value="not"/>
    <display value="Not"/>
    <definition value="The search parameter returns resources that do not contain a match."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
  </concept>
  <concept>
    <code value="text"/>
    <display value="Text"/>
    <definition value="The search parameter is processed as a string that searches text associated with the code/value - either CodeableConcept.text, Coding.display, Identifier.type.text, Identifier.type.coding.display, Identifier.assigner.display, or Reference.display."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="string"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
  </concept>
  <concept>
    <code value="in"/>
    <display value="In"/>
    <definition value="The search parameter is a URI (relative or absolute) that identifies a value set, and the search parameter tests whether the coding is in the specified value set."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
  </concept>
  <concept>
    <code value="not-in"/>
    <display value="Not In"/>
    <definition value="The search parameter is a URI (relative or absolute) that identifies a value set, and the search parameter tests whether the coding is not in the specified value set."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
  </concept>
  <concept>
    <code value="below"/>
    <display value="Below"/>
    <definition value="The search parameter tests whether the value in a resource is subsumed by the specified value (is-a, or hierarchical relationships)."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="uri"/>
    </property>
  </concept>
  <concept>
    <code value="above"/>
    <display value="Above"/>
    <definition value="The search parameter tests whether the value in a resource subsumes the specified value (is-a, or hierarchical relationships)."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="uri"/>
    </property>
  </concept>
  <concept>
    <code value="type"/>
    <display value="Type"/>
    <definition value="The search parameter only applies to the Resource Type specified as a modifier (e.g. the modifier is not actually :type, but :Patient etc.)."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
  </concept>
  <concept>
    <code value="identifier"/>
    <display value="Identifier"/>
    <definition value="The search parameter applies to the Reference.identifier element instead of the Reference.reference element."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
  </concept>
  <concept>
    <code value="of-type"/>
    <display value="Of Type"/>
    <definition value="The search parameter has the format system|code|value. The system and code parts refer to Identifier.type.coding.system and Identifier.type.coding.code and match when the system|code token would match an Identifier.type.coding. The value part matches Identifier.value. All 3 parts must be present."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
  </concept>
  <concept>
    <code value="code-text"/>
    <display value="Code Text"/>
    <definition value="This modifier is used to do a 'standard' string search against code values."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
  </concept>
  <concept>
    <code value="text-advanced"/>
    <display value="Text Advanced"/>
    <definition value="Tests whether the value in a resource matches the supplied parameter value using advanced text handling that searches text associated with the code/value - e.g., CodeableConcept.text, Coding.display, Identifier.type.text, Identifier.type.coding.display, Identifier.assigner.display, or Reference.display."/>
    <property>
      <code value="search-param-type"/>
      <valueCode value="reference"/>
    </property>
    <property>
      <code value="search-param-type"/>
      <valueCode value="token"/>
    </property>
  </concept>
  <concept>
    <code value="iterate"/>
    <display value="Iterate"/>
    <definition value="The search parameter indicates an inclusion directive (_include, _revinclude) that should be applied to included resources as well, rather than only the matching resources."/>
  </concept>
</CodeSystem>