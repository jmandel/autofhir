<?xml version="1.0" encoding="UTF-8"?>

<Bundle xmlns="http://hl7.org/fhir">
  <id value="SpecimenDefinition-search-params"/>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-container"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.typeTested.container.type"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-container"/>
        <description value="The type of specimen conditioned in container expected by the lab"/>
        <code value="container"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.typeTested.container.type"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-context"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="{{name}}.useContext.valueCodeableConcept"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-context"/>
        <description value="A use context assigned to the specimen definition"/>
        <code value="context"/>
        <type value="token"/>
        <expression value="(SpecimenDefinition.useContext.value.ofType(CodeableConcept))"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-context-quantity"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="{{name}}.useContext.valueQuantity,{{name}}.useContext.valueRange"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-context-quantity"/>
        <description value="A quantity- or range-valued use context assigned to the specimen definition"/>
        <code value="context-quantity"/>
        <type value="quantity"/>
        <expression value="(SpecimenDefinition.useContext.value.ofType(Quantity)) | (SpecimenDefinition.useContext.value.ofType(Range))"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-context-type"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="{{name}}.useContext.code"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-context-type"/>
        <description value="A type of use context assigned to the specimen definition"/>
        <code value="context-type"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.useContext.code"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-context-type-quantity"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-context-type-quantity"/>
        <description value="A use context type and quantity- or range-based value assigned to the specimen definition"/>
        <code value="context-type-quantity"/>
        <type value="composite"/>
        <expression value="SpecimenDefinition.useContext"/>
        <processingMode value="normal"/>
        <component>
          <definition value="context-type"/>
          <expression value="code"/>
        </component>
        <component>
          <definition value="context-quantity"/>
          <expression value="value.ofType(Quantity) | value.ofType(Range)"/>
        </component>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-context-type-value"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-context-type-value"/>
        <description value="A use context type and value assigned to the specimen definition"/>
        <code value="context-type-value"/>
        <type value="composite"/>
        <expression value="SpecimenDefinition.useContext"/>
        <processingMode value="normal"/>
        <component>
          <definition value="context-type"/>
          <expression value="code"/>
        </component>
        <component>
          <definition value="context"/>
          <expression value="value.ofType(CodeableConcept)"/>
        </component>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-experimental"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.experimental"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-experimental"/>
        <description value="Not for genuine usage (true)"/>
        <code value="experimental"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.experimental"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-identifier"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.identifier"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-identifier"/>
        <description value="The unique identifier associated with the SpecimenDefinition"/>
        <code value="identifier"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.identifier"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-is-derived"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.typeTested.isDerived"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-is-derived"/>
        <description value="Primary specimen (false) or derived specimen (true)"/>
        <code value="is-derived"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.typeTested.isDerived"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-status"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.status"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-status"/>
        <description value="Publication status of the SpecimenDefinition: draft, active, retired, unknown"/>
        <code value="status"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.status"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-title"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.title"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-title"/>
        <description value="Human-friendly name of the SpecimenDefinition"/>
        <code value="title"/>
        <type value="string"/>
        <expression value="SpecimenDefinition.title"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-type"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.typeCollected"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-type"/>
        <description value="The type of collected specimen"/>
        <code value="type"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.typeCollected"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-type-tested"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.typeTested.type"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-type-tested"/>
        <description value="The type of specimen conditioned for testing"/>
        <code value="type-tested"/>
        <type value="token"/>
        <expression value="SpecimenDefinition.typeTested.type"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="SpecimenDefinition-url"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="SpecimenDefinition.url"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/SpecimenDefinition-url"/>
        <description value="The uri that identifies the specimen definition"/>
        <code value="url"/>
        <type value="uri"/>
        <expression value="SpecimenDefinition.url"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
</Bundle>