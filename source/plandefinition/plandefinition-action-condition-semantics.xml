<?xml version="1.0" encoding="UTF-8"?>

<PlanDefinition xmlns="http://hl7.org/fhir">
  <id value="action-condition-semantics"/>
  <text>
    <status value="generated"/>
    <div xmlns="http://www.w3.org/1999/xhtml">
      <p>This example illustrates how action conditions are interpreted.</p>
      <ul>
        <li>An action with no applicability condition is considered applicable.</li>
        <li>Multiple applicability conditions on the same action are combined using AND semantics.</li>
        <li>Applicability, start, and stop conditions are evaluated separately.</li>
      </ul>
    </div>
  </text>
  <url value="http://example.org/fhir/PlanDefinition/action-condition-semantics"/>
  <version value="1.0.0"/>
  <name value="ActionConditionSemantics"/>
  <title value="Action Condition Semantics"/>
  <status value="draft"/>
  <description value="Illustrates no applicability criteria, multiple applicability criteria, and applicability, start, and stop criteria on PlanDefinition actions."/>
  <purpose value="Demonstrates the PlanDefinition.action.condition semantics clarified for condition kinds and repeated applicability criteria."/>
  <library value="http://example.org/fhir/Library/action-condition-semantics"/>
  <action>
    <title value="Action group demonstrating condition behavior"/>
    <groupingBehavior value="logical-group"/>
    <selectionBehavior value="all"/>
    <action id="no-applicability-criteria">
      <title value="Provide standard education"/>
      <description value="No applicability conditions are present, so this action is considered applicable."/>
    </action>
    <action id="multiple-applicability-criteria">
      <title value="Recommend care management referral"/>
      <description value="This action applies only when all applicability conditions evaluate to true."/>
      <condition>
        <kind value="applicability"/>
        <expression>
          <description value="The patient is an adult."/>
          <language value="text/cql-identifier"/>
          <expression value="Is Adult"/>
        </expression>
      </condition>
      <condition>
        <kind value="applicability"/>
        <expression>
          <description value="The patient has an active chronic condition."/>
          <language value="text/cql-identifier"/>
          <expression value="Has Active Chronic Condition"/>
        </expression>
      </condition>
    </action>
    <action id="applicability-start-stop-criteria">
      <title value="Schedule follow-up assessment"/>
      <description value="Applicability determines whether the action is included; start and stop criteria are carried separately as entry and exit criteria."/>
      <condition>
        <kind value="applicability"/>
        <expression>
          <description value="The patient needs follow-up."/>
          <language value="text/cql-identifier"/>
          <expression value="Needs Follow Up"/>
        </expression>
      </condition>
      <condition>
        <kind value="start"/>
        <expression>
          <description value="The follow-up window has opened."/>
          <language value="text/cql-identifier"/>
          <expression value="Follow Up Window Open"/>
        </expression>
      </condition>
      <condition>
        <kind value="stop"/>
        <expression>
          <description value="The follow-up assessment has been completed."/>
          <language value="text/cql-identifier"/>
          <expression value="Follow Up Completed"/>
        </expression>
      </condition>
    </action>
  </action>
</PlanDefinition>
