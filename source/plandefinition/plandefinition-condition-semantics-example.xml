<?xml version="1.0" encoding="UTF-8"?>

<PlanDefinition xmlns="http://hl7.org/fhir">
  <id value="condition-semantics-example"/>
  <name value="ConditionSemanticsExample"/>
  <title value="Condition Semantics Example"/>
  <status value="draft"/>
  <description value="An example illustrating PlanDefinition action condition semantics for actions with no applicability criteria, multiple applicability criteria, and mixed condition kinds."/>
  <action>
    <title value="Action with no applicability criteria"/>
    <description value="No applicability condition is present, so the action is considered applicable."/>
  </action>
  <action>
    <title value="Action with multiple applicability criteria"/>
    <description value="Multiple applicability conditions are combined using AND semantics."/>
    <condition>
      <kind value="applicability"/>
      <expression>
        <description value="The patient is an adult"/>
        <language value="text/cql-identifier"/>
        <expression value="Is Adult"/>
      </expression>
    </condition>
    <condition>
      <kind value="applicability"/>
      <expression>
        <description value="The patient has a qualifying diagnosis"/>
        <language value="text/cql-identifier"/>
        <expression value="Has Qualifying Diagnosis"/>
      </expression>
    </condition>
  </action>
  <action>
    <title value="Action with applicability, start, and stop criteria"/>
    <description value="Applicability criteria determine whether the action applies; start and stop criteria describe lifecycle conditions and are evaluated independently of applicability."/>
    <condition>
      <kind value="applicability"/>
      <expression>
        <description value="The patient is eligible for the action"/>
        <language value="text/cql-identifier"/>
        <expression value="Is Eligible"/>
      </expression>
    </condition>
    <condition>
      <kind value="start"/>
      <expression>
        <description value="The action should be started"/>
        <language value="text/cql-identifier"/>
        <expression value="Should Start"/>
      </expression>
    </condition>
    <condition>
      <kind value="stop"/>
      <expression>
        <description value="The action should be stopped"/>
        <language value="text/cql-identifier"/>
        <expression value="Should Stop"/>
      </expression>
    </condition>
  </action>
</PlanDefinition>
