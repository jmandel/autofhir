<?xml version="1.0" encoding="UTF-8"?>

<Bundle xmlns="http://hl7.org/fhir">
  <id value="ObservationDefinition-search-params"/>
  <entry>
    <resource>
      <SearchParameter>
        <id value="ObservationDefinition-category"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="ObservationDefinition.category"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-category"/>
        <description value="Category (class) of observation"/>
        <code value="category"/>
        <type value="token"/>
        <expression value="ObservationDefinition.category"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="ObservationDefinition-code"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="ObservationDefinition.code"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-code"/>
        <description value="Observation code"/>
        <code value="code"/>
        <type value="token"/>
        <expression value="ObservationDefinition.code"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="ObservationDefinition-context"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="{{name}}.useContext.valueCodeableConcept"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-context"/>
        <description value="A use context assigned to the observation definition"/>
        <code value="context"/>
        <type value="token"/>
        <expression value="(ObservationDefinition.useContext.value.ofType(CodeableConcept))"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="ObservationDefinition-context-quantity"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="{{name}}.useContext.valueQuantity,{{name}}.useContext.valueRange"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-context-quantity"/>
        <description value="A quantity- or range-valued use context assigned to the observation definition"/>
        <code value="context-quantity"/>
        <type value="quantity"/>
        <expression value="(ObservationDefinition.useContext.value.ofType(Quantity)) | (ObservationDefinition.useContext.value.ofType(Range))"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="ObservationDefinition-context-type"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="{{name}}.useContext.code"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-context-type"/>
        <description value="A type of use context assigned to the observation definition"/>
        <code value="context-type"/>
        <type value="token"/>
        <expression value="ObservationDefinition.useContext.code"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="ObservationDefinition-context-type-quantity"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-context-type-quantity"/>
        <description value="A use context type and quantity- or range-based value assigned to the observation definition"/>
        <code value="context-type-quantity"/>
        <type value="composite"/>
        <expression value="ObservationDefinition.useContext"/>
        <processingMode value="normal"/>
        <component>
          <definition value="context-type"/>
          <expression value="code"/>
        </component>
        <component>
          <definition value="context-quantity"/>
          <expression value="value.ofType(Quantity) | value.ofType(Range)"/>
        </component>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
        <id value="ObservationDefinition-context-type-value"/>
        <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
          <valueCode value="normative"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-context-type-value"/>
        <description value="A use context type and value assigned to the observation definition"/>
        <code value="context-type-value"/>
        <type value="composite"/>
        <expression value="ObservationDefinition.useContext"/>
        <processingMode value="normal"/>
        <component>
          <definition value="context-type"/>
          <expression value="code"/>
        </component>
        <component>
          <definition value="context"/>
          <expression value="value.ofType(CodeableConcept)"/>
        </component>
      </SearchParameter>
    </resource>
  </entry>
  <entry>
    <resource>
      <SearchParameter>
