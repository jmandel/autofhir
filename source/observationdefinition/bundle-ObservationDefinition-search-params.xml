        </extension>
        <extension url="http://hl7.org/fhir/build/StructureDefinition/path">
          <valueString value="ObservationDefinition.method"/>
        </extension>
        <url value="http://hl7.org/fhir/build/SearchParameter/ObservationDefinition-method"/>
        <description value="Method of observation"/>
        <code value="method"/>
        <type value="token"/>
        <expression value="ObservationDefinition.method"/>
        <processingMode value="normal"/>
      </SearchParameter>
    </resource>
